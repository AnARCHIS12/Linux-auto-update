#!/usr/bin/env bash
set -Eeuo pipefail
LOCK_FILE="/run/lock/linux-auto-update.lock"
log(){ printf '[linux-auto-update] %s\n' "$*"; }
die(){ log "ERROR: $*"; exit 1; }
manager(){
 command -v dnf >/dev/null && echo dnf || command -v apt-get >/dev/null && echo apt || command -v pacman >/dev/null && echo pacman || command -v zypper >/dev/null && echo zypper || command -v apk >/dev/null && echo apk || command -v xbps-install >/dev/null && echo xbps || command -v emerge >/dev/null && echo emerge || die "Gestionnaire non pris en charge."
}
os(){ . /etc/os-release 2>/dev/null; echo "${PRETTY_NAME:-Linux}"; }
update_native(){
 case "$1" in
 dnf) dnf -y upgrade --refresh;;
 apt) export DEBIAN_FRONTEND=noninteractive; apt-get update; apt-get -y upgrade;;
 pacman) pacman --noconfirm -Syu;;
 zypper) zypper --non-interactive refresh; zypper --non-interactive update;;
 apk) apk update; apk upgrade;;
 xbps) xbps-install -Syu;;
 emerge) emerge --sync; emerge --update --deep --newuse @world;;
 esac
}
reboot_required(){
 command -v needs-restarting >/dev/null && ! needs-restarting -r >/dev/null 2>&1 && return 0
 [[ -e /run/reboot-required ]]
}
status(){
 local m; m="$(manager)"
 echo "Distribution : $(os)"
 echo "Gestionnaire : $m"
 echo "Flatpak      : $(command -v flatpak >/dev/null && echo oui || echo non)"
 echo "Snap         : $(command -v snap >/dev/null && echo oui || echo non)"
 echo "fwupd        : $(command -v fwupdmgr >/dev/null && echo oui || echo non)"
 echo "Redémarrage  : $(reboot_required && echo requis || echo non signalé)"
}
check(){
 [[ $EUID -eq 0 ]] || exec sudo "$0" check
 local m; m="$(manager)"
 case "$m" in
 dnf) dnf check-update --refresh || [[ $? -eq 100 ]];;
 apt) apt-get update; apt list --upgradable 2>/dev/null || true;;
 pacman) pacman -Qu || true;;
 zypper) zypper --non-interactive list-updates || true;;
 apk) apk version -l '<' || true;;
 xbps) xbps-install -Mun || true;;
 emerge) emerge -pvuDN @world || true;;
 esac
}
update(){
 [[ $EUID -eq 0 ]] || exec sudo "$0" update
 exec 9>"$LOCK_FILE"; flock -n 9 || die "Une mise à jour est déjà en cours."
 local m; m="$(manager)"
 log "Système : $(os)"; log "Gestionnaire : $m"
 update_native "$m"
 command -v flatpak >/dev/null && flatpak update -y || true
 [[ "${LINUX_AUTO_UPDATE_ENABLE_SNAP:-0}" == 1 ]] && command -v snap >/dev/null && snap refresh
 if [[ "${LINUX_AUTO_UPDATE_ENABLE_FWUPD:-0}" == 1 ]] && command -v fwupdmgr >/dev/null; then fwupdmgr refresh --force || true; fwupdmgr update -y; fi
 reboot_required && log "Un redémarrage est requis." || true
 log "Mise à jour terminée."
}
case "${1:-status}" in check) check;; update) update;; status) status;; *) echo "Usage: linux-auto-update {check|update|status}"; exit 2;; esac
